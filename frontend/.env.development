# `npm run tauri dev` / `npm run dev` connect straight to a backend started by
# hand (or by a dev script) instead of going through the Tauri sidecar
# handshake — see src/api/backend.ts. Start the backend with the matching
# token before running the frontend:
#
#   ARCGDLW_DEV_TOKEN=devtoken PYTHONPATH=src uv run python -m arcgdlw.main --serve --port 8734
#
VITE_BACKEND_PORT=8734
VITE_BACKEND_TOKEN=devtoken
